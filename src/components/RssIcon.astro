---
// 标准 RSS 图标（描边 + 实心圆点），颜色跟随 currentColor。
interface Props {
  size?: number;
  class?: string;
}
const { size = 14, class: className } = Astro.props;
---
<svg
  class:list={['rss-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M4 11a9 9 0 0 1 9 9" />
  <path d="M4 4a16 16 0 0 1 16 16" />
  <circle cx="5" cy="19" r="1.6" fill="currentColor" stroke="none" />
</svg>
