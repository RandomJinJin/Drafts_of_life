---
import { getCollection } from 'astro:content';
import Newspaper from '../layouts/Newspaper.astro';
import series from '../content/series.json';
import { formatDate } from '../data/date';
import { readingMinutes } from '../data/reading-time';
import AuthorLink from '../components/AuthorLink.astro';
import SourceTag from '../components/SourceTag.astro';
const stories = (await getCollection('stories')).sort((a,b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const visibleSeries = series.filter(item => stories.some(story => story.data.series === item.slug));
const [lead, ...rest] = stories;
const storyUrl = (id: string) => `/stories/${id}/`;
---
<Newspaper>
  <div class="issue"><h1>本期头版</h1><div class="issue-note">最新刊登 · {formatDate(lead.data.publishedAt)}</div></div>
  <div class="lead-grid">
    <article class="lead"><div class="kicker">最新刊登 / {series.find(s => s.slug === lead.data.series)?.title ?? '独立短篇'}</div><h2><a href={storyUrl(lead.id)}>{lead.data.title}</a></h2><p class="deck">{lead.data.description}</p>{lead.data.cover && <><a class="lead-image-link" href={storyUrl(lead.id)} aria-label={`阅读《${lead.data.title}》`}><img class="lead-image" src={lead.data.cover.src} width="1536" height="1024" fetchpriority="high" decoding="async" alt={`${lead.data.title}配图`} /></a><p class="caption">{lead.data.cover.caption}</p></>}<div class="meta"><span>作者：<AuthorLink name={lead.data.author} url={lead.data.authorurl} /></span><span>约 {readingMinutes(lead)} 分钟阅读</span><SourceTag source={lead.data.source} /></div><a class="text-link" href={storyUrl(lead.id)}>阅读这篇故事 →</a></article>
    <aside class="sidebar"><div class="section-label">近期文章</div>{rest.slice(0,3).map(story => <article class="brief"><div class="kicker">{series.find(s => s.slug === story.data.series)?.title ?? '独立短篇'}</div><h3><a href={storyUrl(story.id)}>{story.data.title}</a></h3><p>{story.data.description}</p><div class="meta"><span><AuthorLink name={story.data.author} url={story.data.authorurl} /></span><time datetime={story.data.publishedAt.toISOString()}>{formatDate(story.data.publishedAt)}</time><SourceTag source={story.data.source} /></div></article>)}</aside>
  </div>
  {rest.length > 3 && <section class="middle" aria-label="本期选读"><article class="feature-small"><div class="section-label">本期选读</div><div class="kicker">{series.find(s => s.slug === rest[3].data.series)?.title ?? '独立短篇'}</div><h3><a href={storyUrl(rest[3].id)}>{rest[3].data.title}</a></h3><p>{rest[3].data.description}</p><div class="meta"><span><AuthorLink name={rest[3].data.author} url={rest[3].data.authorurl} /></span><span>约 {readingMinutes(rest[3])} 分钟阅读</span><SourceTag source={rest[3].data.source} /></div></article><div class="minor-grid">{rest.slice(4,6).map(story => <article class="minor-story"><div class="kicker">{series.find(s => s.slug === story.data.series)?.title ?? '独立短篇'}</div><h3><a href={storyUrl(story.id)}>{story.data.title}</a></h3><p>{story.data.description}</p><div class="meta"><span><AuthorLink name={story.data.author} url={story.data.authorurl} /></span><SourceTag source={story.data.source} /></div></article>)}</div></section>}
  <section class="series"><div class="series-head"><h2>按系列阅读</h2><a class="text-link" href="/series/">查看全部系列 →</a></div><div class="series-grid">{visibleSeries.map(item => {const count = stories.filter(story => story.data.series === item.slug).length;return <a class="series-item" href={`/series/${item.slug}/`}><span class="series-count">{item.status} · {count} 篇</span><h3>{item.title}</h3><p>{item.description}</p></a>})}</div></section>
</Newspaper>
