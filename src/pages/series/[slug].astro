---
import { getCollection } from 'astro:content';
import Newspaper from '../../layouts/Newspaper.astro';
import CharacterGraph from '../../components/CharacterGraph.astro';
import { getCharacterGraph } from '../../data/characters';
import series from '../../content/series.json';
import { formatDate } from '../../data/date';
import AuthorLink from '../../components/AuthorLink.astro';
import SourceTag from '../../components/SourceTag.astro';
export async function getStaticPaths() { const stories = await getCollection('stories'); return series.filter(item => stories.some(story => story.data.series === item.slug)).map(item => ({ params: { slug: item.slug }, props: { item } })); }
const { item } = Astro.props;
const characterGraph = getCharacterGraph(item.slug);
const stories = (await getCollection('stories')).filter(story => story.data.series === item.slug).sort((a,b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime());
const digits = ['零', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
function chapterNumber(value: number) {
  if (value < 10) return digits[value];
  if (value < 100) return `${value >= 20 ? digits[Math.floor(value / 10)] : ''}十${value % 10 ? digits[value % 10] : ''}`;
  return String(value);
}
---
<Newspaper title={item.title} description={item.description}><div class="page-intro"><div class="kicker">{item.status} · {stories.length} 篇</div><h1>{item.title}</h1><p>{item.description}</p></div>{characterGraph && characterGraph.characters.length > 0 && <CharacterGraph data={characterGraph} seriesTitle={item.title} />}<div class="listing">{stories.map((story, index) => <article><div class="kicker">第{chapterNumber(index + 1)}篇</div><h2><a href={`/stories/${story.id}/`}>{story.data.title}</a></h2><p>{story.data.description}</p><div class="meta"><span><AuthorLink name={story.data.author} url={story.data.authorurl} /></span><time datetime={story.data.publishedAt.toISOString()}>{formatDate(story.data.publishedAt)}</time><SourceTag source={story.data.source} /></div></article>)}</div><a class="text-link" href="/series/">← 返回系列索引</a></Newspaper>
